# DevO environment configuration
# Copy this file to .env and add your Groq API key

# Required: Your Groq API key
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model (defaults to qwen/qwen3.8-27b)
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: Default repository path
# DEFAULT_REPO_PATH=.

# Optional: Enable debug mode
# DEBUG=false
